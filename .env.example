# Build-time Vite env vars. Copy to .env for local dev. All client-side vars
# must be prefixed with VITE_ and are baked into the bundle at build time.

# VITE_USE_MOCK: "true" runs the app on in-memory storage with NO MSAL and NO
# Azure config — the fastest way to demo the UI (`npm run dev:mock`).
VITE_USE_MOCK=false

# Entra ID SPA app registration (live mode).
VITE_CLIENT_ID=
VITE_AUTHORITY_URI=https://login.microsoftonline.com/<tenant-id>
VITE_REDIRECT_URI=http://localhost:5173/

# Storage account NAME only (not a URL), and the container that holds the
# per-user folders. The container must already exist.
VITE_STORAGE_ACCOUNT=
VITE_CONTAINER=drop
